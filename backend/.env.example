# ==========================================
# Student Expense Tracker - Backend Environment Variables
# ==========================================
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Do NOT commit your real '.env' file to Git!

# Server port (defaults to 5000 if omitted)
PORT=5000

# MongoDB Atlas connection string
# Example format from MongoDB Atlas dashboard:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/expense_tracker?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Secret key used for signing JSON Web Tokens (JWT)
# Use a random, strong secret string for security
JWT_SECRET=your_secret_jwt_signing_key_here
